#!/usr/bin/env node
// CommonJS on purpose: extensionless ES modules do not run in the sandbox.
import("../node_modules/youtube-playlist-downloader/dist/src/cli.js").then(({ main }) => main()).catch((error) => {
  console.error(`✗ ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
});
