{
  "name": "youtube-playlist-downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "yt-download": "bin/yt-download" },
  "files": ["bin/", "dist/src/"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "start": "node bin/yt-download",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
